<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- SolarFramework comes from GitHub Packages, which needs a token even to read: see README.md -->
    <parent>
        <groupId>org.solarframework.mu</groupId>
        <artifactId>solar-framework</artifactId>
        <version>1.0</version>
        <relativePath/>
    </parent>

    <groupId>mu.mosaic</groupId>
    <artifactId>OpportunityApp</artifactId>
    <version>0.1.0</version>
    <name>OpportunityApp</name>
    <description>Mosaic website: Spring Boot and Thymeleaf on SolarFramework, over the analytics API in ../../AI</description>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/solarflare-mu/solarframework</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>web-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- The Python API client and launcher, formatting and the local AI: everything that is not web -->
        <dependency>
            <groupId>mu.mosaic</groupId>
            <artifactId>OpportunityImpl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The business database: SolarFramework's DatabaseImpl on SQLite -->
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>database-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- The one LLM client: the scenario summary and the assistant both run through AIImpl -->
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>ai-impl</artifactId>
        </dependency>
        <!-- AIImpl marks these optional, but AIConfig's cache bean needs them -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Bootstrap and Chart.js served from the jar, as SolarERP's pages use them, so a demo needs no CDN -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap</artifactId>
            <version>5.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>chart.js</artifactId>
            <version>4.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <!-- Sign-in as in SolarERP: form login, remember-me, Google, and password-reset emails through SolarFramework's mailer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>mailer-impl</artifactId>
        </dependency>
        <!-- OpportunityImpl's trimmed API responses (Fixtures, src/test/resources/api) for the page tests -->
        <dependency>
            <groupId>mu.mosaic</groupId>
            <artifactId>OpportunityImpl</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- The SolarFramework parent pins compiler 3.8.1, which predates Java 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
