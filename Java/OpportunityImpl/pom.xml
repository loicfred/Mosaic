<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- SolarFramework comes from GitHub Packages, which needs a token even to read: see ../OpportunityApp/README.md -->
    <parent>
        <groupId>org.solarframework.mu</groupId>
        <artifactId>solar-framework</artifactId>
        <version>1.0</version>
        <relativePath/>
    </parent>

    <groupId>mu.mosaic</groupId>
    <artifactId>OpportunityImpl</artifactId>
    <version>0.1.0</version>
    <name>OpportunityImpl</name>
    <description>Mosaic's non-web logic: the Python API client and launcher, display formatting and the local AI. No controllers, templates or database.</description>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/solarflare-mu/solarframework</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- Starts and stops the Python analytics API with the host application -->
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>python-runner</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>ai-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>ai-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient and its JSON conversion, without the servlet stack -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- The assistant's per-session conversation cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The trimmed API responses in src/test/resources/api are shared with OpportunityApp's page tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The SolarFramework parent pins compiler 3.8.1, which predates Java 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
