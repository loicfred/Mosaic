<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- SolarFramework comes from GitHub Packages, which needs a token even to read: see ../OpportunityApp/README.md -->
    <parent>
        <groupId>org.solarframework.mu</groupId>
        <artifactId>solar-framework</artifactId>
        <version>1.0</version>
        <relativePath/>
    </parent>

    <groupId>mu.mosaic</groupId>
    <artifactId>OpportunityImpl</artifactId>
    <version>0.1.0</version>
    <name>OpportunityImpl</name>
    <description>Mosaic's non-web logic: the Python API client and launcher, display formatting and the local AI. No controllers, templates or database.</description>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/solarflare-mu/solarframework</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- Starts and stops the Python analytics API with the host application -->
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>python-runner</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>ai-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>ai-impl</artifactId>
        </dependency>
        <!-- The analytics API's replies are read into typed records through SolarFramework's Gson (JSONItem.SimpleGSON) -->
        <dependency>
            <groupId>org.solarframework.mu</groupId>
            <artifactId>json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient and its JSON conversion, without the servlet stack -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Every build re-zips ../OpportunityApp/config/py/mosaic/app into mosaic-python.zip, so the jar always carries the current Python code;
                 PythonApiLauncher unpacks it into SolarHome/config/py/mosaic on start. Same content as .claude/hooks/package-python.ps1. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>package-python</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${project.basedir}/src/main/resources/mosaic-python.zip"/>
                                <zip destfile="${project.basedir}/src/main/resources/mosaic-python.zip" basedir="${project.basedir}/../OpportunityApp/config/py/mosaic"
                                     includes="app/**/*.py" excludes="**/__pycache__/**" whenempty="fail"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The SolarFramework parent pins compiler 3.8.1, which predates Java 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
