# Copy to backend/.env (scripts/bootstrap.py does this for you with random secrets).
# Never commit the real .env file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://opportunityos:CHANGE_ME@localhost:5432/opportunityos
JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_characters
AUDIT_IP_SALT=CHANGE_ME_random_hex
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when served over HTTPS (forced on when APP_ENV=production)
COOKIE_SECURE=false
